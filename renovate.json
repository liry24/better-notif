{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
    "baseBranchPatterns": ["main"],
    "branchPrefix": "renovate/",
    "automerge": false,
    "dependencyDashboard": true,
    "timezone": "Asia/Tokyo",
    "schedule": ["* * * * 0"],
    "prConcurrentLimit": 1,
    "branchConcurrentLimit": 1,
    "prHourlyLimit": 1,
    "rebaseWhen": "behind-base-branch",
    "updateNotScheduled": true,
    "ignoreScripts": true,
    "constraints": {
        "bun": "1.4.2"
    },
    "lockFileMaintenance": {
        "enabled": false
    },
    "vulnerabilityAlerts": {
        "enabled": true,
        "schedule": [],
        "minimumReleaseAge": null,
        "dependencyDashboardApproval": false,
        "automerge": false
    },
    "prBodyNotes": [
        "Rebase onto the latest base, reapply manifest changes and regenerate existing bun.lock files with the pinned Bun. Commit manifests and locks together; frozen installation and all quality checks must pass."
    ],
    "packageRules": [
        {
            "description": "Apply npm policy to native Bun and npm dependencies",
            "matchDatasources": ["npm"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Keep runtime and package-manager upgrades owner-managed",
            "matchDepTypes": ["engines", "packageManager", "devEngines.runtime", "devEngines.packageManager"],
            "enabled": false
        },
        {
            "description": "Keep Bun pinned in manifests, workflow inputs and Renovate tool constraints",
            "matchDepNames": ["bun"],
            "enabled": false
        },
        {
            "description": "Require approval for major updates",
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Review public compatibility range changes",
            "matchDepTypes": ["peerDependencies"],
            "enabled": true,
            "dependencyDashboardApproval": true,
            "rangeStrategy": "replace"
        },
        {
            "description": "Review breaking zero-major minor updates separately",
            "matchDatasources": ["npm"],
            "matchCurrentVersion": "/^0\\./",
            "matchUpdateTypes": ["minor"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Pin and review GitHub Actions separately",
            "matchManagers": ["github-actions"],
            "groupName": "GitHub Actions",
            "pinDigests": true,
            "automerge": false
        },
        {
            "description": "Keep Vue and compiler packages together",
            "matchPackageNames": ["vue", "/^@vue\\//"],
            "groupName": "Vue and compiler"
        },
        {
            "description": "Keep Vite+ core, Vite+ and Vitest together",
            "matchPackageNames": ["vite", "vite-plus", "@voidzero-dev/vite-plus-core", "vitest", "/^@vitest\\//"],
            "groupName": "Vite and test tooling"
        },
        {
            "description": "Keep Better Auth and its adapters together",
            "matchPackageNames": ["better-auth", "auth", "/^@better-auth\\//"],
            "groupName": "Better Auth"
        },
        {
            "description": "Preserve the public Better Auth minimum; change only with minimum consumer evidence",
            "matchDepTypes": ["peerDependencies"],
            "matchPackageNames": ["better-auth", "@better-auth/core"],
            "enabled": false
        }
    ]
}
