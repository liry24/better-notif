{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "workspaces": {
        ".": {
            "entry": ["*.config.ts", "test/**/*.test.ts", "test/types.ts"],
            "project": ["*.ts", "test/**/*.ts"]
        },
        "packages/better-notif": {
            "entry": ["src/{index,client}.ts!"],
            "ignoreDependencies": ["@arethetypeswrong/cli", "publint"],
            "project": ["src/**/*.ts!", "*.config.ts"]
        }
    }
}
